generator client {
  provider = "prisma-client-py"
  interface = "asyncio"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum CompoundName { SOFT MEDIUM HARD INTERMEDIATE WET }
enum TrackStatus { GREEN YELLOW VSC SAFETY_CAR RED_FLAG WET CHEQUERED }
enum RaceStatus { SCHEDULED RUNNING FINISHED }
enum EventType { SAFETY_CAR VSC YELLOW RED_FLAG GREEN_FLAG RAIN PIT_WINDOW OTHER }
model Circuit { id String @id @default(cuid()) name String @unique country String city String? lengthKm Float? characteristics Json? races Race[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Team { id String @id @default(cuid()) name String @unique color String? drivers Driver[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Driver { id String @id @default(cuid()) code String @unique name String teamId String team Team @relation(fields:[teamId], references:[id], onDelete:Restrict) raceStates RaceState[] stints TireStint[] pitStops PitStop[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Race { id String @id @default(cuid()) slug String @unique name String year Int totalLaps Int circuitId String circuit Circuit @relation(fields:[circuitId], references:[id], onDelete:Restrict) status RaceStatus @default(SCHEDULED) states RaceState[] stints TireStint[] pitStops PitStop[] weather WeatherObservation[] forecasts WeatherForecast[] events RaceControlEvent[] telemetry TelemetrySnapshot[] strategies StrategyOption[] simulations StrategySimulation[] recommendations StrategyRecommendation[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@index([year, name]) }
model RaceState { id String @id @default(cuid()) raceId String race Race @relation(fields:[raceId], references:[id], onDelete:Cascade) lap Int timestamp DateTime @default(now()) trackStatus TrackStatus @default(GREEN) safetyCarActive Boolean @default(false) positions Json gaps Json weather Json? fuelEstimates Json? driverId String? driver Driver? @relation(fields:[driverId], references:[id], onDelete:SetNull) createdAt DateTime @default(now()) @@index([raceId, lap]) @@index([timestamp]) }
model TireCompound { id String @id @default(cuid()) name CompoundName @unique paceDelta Float wearFactor Float wetPerformance Float stints TireStint[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model TireStint { id String @id @default(cuid()) driverId String driver Driver @relation(fields:[driverId], references:[id], onDelete:Cascade) raceId String race Race @relation(fields:[raceId], references:[id], onDelete:Cascade) compoundId String compound TireCompound @relation(fields:[compoundId], references:[id], onDelete:Restrict) startLap Int endLap Int? startingAge Int @default(0) wearPercent Float? metadata Json? createdAt DateTime @default(now()) @@index([raceId, driverId, startLap]) }
model PitStop { id String @id @default(cuid()) raceId String race Race @relation(fields:[raceId], references:[id], onDelete:Cascade) driverId String driver Driver @relation(fields:[driverId], references:[id], onDelete:Cascade) lap Int durationSeconds Float? compoundIn CompoundName? compoundOut CompoundName? underSafetyCar Boolean @default(false) metadata Json? createdAt DateTime @default(now()) @@index([raceId, lap]) }
model WeatherObservation { id String @id @default(cuid()) raceId String race Race @relation(fields:[raceId], references:[id], onDelete:Cascade) timestamp DateTime @default(now()) lap Int? airTempC Float? trackTempC Float? humidity Float? rainfallMm Float @default(0) windSpeed Float? windDirection Int? source String @default("demo") metadata Json? @@index([raceId, timestamp]) }
model WeatherForecast { id String @id @default(cuid()) raceId String race Race @relation(fields:[raceId], references:[id], onDelete:Cascade) issuedAt DateTime @default(now()) targetLap Int? rainProbability Float rainfallExpected Boolean @default(false) expectedRainfallMm Float? trackTempC Float? source String @default("demo") metadata Json? @@index([raceId, issuedAt]) }
model RaceControlEvent { id String @id @default(cuid()) raceId String race Race @relation(fields:[raceId], references:[id], onDelete:Cascade) lap Int type EventType message String active Boolean @default(true) timestamp DateTime @default(now()) metadata Json? @@index([raceId, lap, type]) }
model TelemetrySnapshot { id String @id @default(cuid()) raceId String race Race @relation(fields:[raceId], references:[id], onDelete:Cascade) driverCode String lap Int timestamp DateTime @default(now()) speedKph Float? throttle Float? brake Float? gear Int? rpm Int? distanceM Float? metadata Json? @@index([raceId, driverCode, lap]) @@index([timestamp]) }
model StrategyOption { id String @id @default(cuid()) raceId String race Race @relation(fields:[raceId], references:[id], onDelete:Cascade) key String name String action String compound CompoundName? description String? enabled Boolean @default(true) simulations StrategySimulation[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt @@unique([raceId, key]) }
model StrategySimulation { id String @id @default(cuid()) raceId String race Race @relation(fields:[raceId], references:[id], onDelete:Cascade) optionId String option StrategyOption @relation(fields:[optionId], references:[id], onDelete:Cascade) lap Int iterations Int expectedRemainingSeconds Float expectedPosition Float confidence Float riskScores Json results Json createdAt DateTime @default(now()) @@index([raceId, lap]) }
model StrategyRecommendation { id String @id @default(cuid()) raceId String race Race @relation(fields:[raceId], references:[id], onDelete:Cascade) lap Int action String compound CompoundName? optionKey String rationale String risks Json triggerConditions Json expectedOutcome Json confidence Float createdAt DateTime @default(now()) @@index([raceId, lap]) }
